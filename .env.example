# Copy to .env and fill in. Generate secrets with: openssl rand -base64 32
POSTGRES_USER=totp
# Production (NODE_ENV=production) refuses to start while this is still "change-me".
POSTGRES_PASSWORD=change-me
POSTGRES_DB=totp
DATABASE_URL=postgres://totp:change-me@localhost:5433/totp
# 32 random bytes, base64. Keys the HMAC of recovery keys and decoy salts.
SERVER_PEPPER=
# Public origin of the app, used for Origin checks and cookie flags.
APP_ORIGIN=http://localhost:3000
# Registration is open only while no account exists, unless this is true.
ALLOW_REGISTRATION=false
# true only behind a reverse proxy you control that OVERWRITES X-Forwarded-For.
# docker-compose.yml defaults this to true for the app service.
TRUST_PROXY=false
# Required to create the first account on a non-loopback APP_ORIGIN. At least 16 characters:
#   openssl rand -base64 24
SETUP_TOKEN=
DATABASE_URL_TEST=postgres://totp:change-me@localhost:5433/totp_test
DATABASE_URL_E2E=postgres://totp:change-me@localhost:5433/totp_e2e
